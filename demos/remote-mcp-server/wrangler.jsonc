/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "remote-mcp-server",
	"main": "src/index.ts",
	"compatibility_date": "2025-03-10",
	"compatibility_flags": ["nodejs_compat"],
	// The URL MCP clients connect to. Set it to your deployed URL, for example
	// https://<worker-name>.<your-subdomain>.workers.dev/mcp
	"vars": {
		"MCP_RESOURCE": "http://localhost:8787/mcp",
	},
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "<ADD YOUR KV NAMESPACEID HERE>",
		},
	],
	"observability": {
		"enabled": true,
	},
	"assets": { "directory": "./static/", "binding": "ASSETS" },
}
